# ---------- Agent backend (npm run server) ----------
# Google Gemini: enables real reasoning + multi-step tool use. Without it the agent runs in basic mode.
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest)
GEMINI_MODEL=

# Browserbase: real cloud Chrome with live view + recordings. Without it pages are fetched over HTTP.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional shared secret. When set, every /api request must send "Authorization: Bearer <token>".
MUSE_API_TOKEN=
# Optional comma-separated CORS allowlist, e.g. http://localhost:8081
CORS_ORIGINS=
PORT=3001
# Where tasks/feed are persisted (default: server/data)
MUSE_DATA_DIR=

# ---------- Expo app ----------
# Backend URL; defaults to the Metro host machine on port 3001
EXPO_PUBLIC_API_URL=
# Must match MUSE_API_TOKEN when that is set
EXPO_PUBLIC_MUSE_API_TOKEN=
# Supabase auth (defaults to the bundled project)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Gmail & Google Calendar connectors ----------
# Google Cloud Console → APIs & Services: enable Gmail API + Google Calendar API,
# create an OAuth client (type "Web application") and add the redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3001/api/connectors/google/callback
# Web app origin allowed as a post-connect return URL (e.g. https://muse.example.com)
APP_URL=
# Timezone for created calendar events (default: server timezone)
GOOGLE_CALENDAR_TZ=
